rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow anyone to read images
    match /{allPaths=**} {
      allow read: if true;
    }

    // Allow authenticated users to upload to all folders
    match /attractions/{fileName} {
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }

    match /tours/{fileName} {
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }

    match /hero/{fileName} {
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }

    match /testimonials/{fileName} {
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }

    match /uploads/{fileName} {
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }

  }
}
